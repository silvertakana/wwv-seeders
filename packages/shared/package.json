{
  "name": "@worldwideview/seeder-sdk",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.mts')\""
  },
  "dependencies": {
    "@sentry/node": "^8.38.0",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^17.4.2",
    "geoip-lite": "^2.0.3",
    "ioredis": "^6.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.4.1",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  }
}
